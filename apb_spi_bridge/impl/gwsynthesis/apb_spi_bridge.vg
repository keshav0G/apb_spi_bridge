    .clkdiv_Z_0(clkdiv_Z[0]),
    .clkdiv_Z_1(clkdiv_Z[1]),
    .clkdiv_Z_3(clkdiv_Z[3]),
    .clkdiv_Z_7(clkdiv_Z[7])
);
  spi_master u_spi_master (
